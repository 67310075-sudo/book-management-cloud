# Django Application Secret Key
SECRET_KEY=django-insecure-your-super-secret-key-change-this-in-production

# Debug Mode (set to False on Render/Production)
DEBUG=False

# Allowed Hosts (comma-separated or * for all)
ALLOWED_HOSTS=*

# CORS Settings
CORS_ALLOW_ALL=True

# JWT Secret Key for token signing
JWT_SECRET=my_bookstore_secret

# Database Settings for Aiven Cloud MySQL
# Leave DB_HOST blank if using local SQLite fallback
DB_ENGINE=django.db.backends.mysql
DB_HOST=
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL_REQUIRED=True
DB_SSL_CA=aiven_ca.pem

# Email Settings (Gmail SMTP for PIN verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
